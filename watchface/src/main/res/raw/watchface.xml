<?xml version="1.0" encoding="utf-8"?>
<!--
  Cadran Agentchi (Watch Face Format, version 1) : l'heure en haut, la mascotte en grand au centre,
  sa forme en bas. La mascotte et sa forme viennent de la complication de l'appli Agentchi
  (widget/PetComplicationService) : elles suivent son humeur et s'affolent quand un agent attend.
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <Scene backgroundColor="#FF141413">
    <DigitalClock x="75" y="34" width="300" height="96">
      <TimeText x="0" y="0" width="300" height="96" format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="84" weight="MEDIUM" color="#FFFAF9F5" />
      </TimeText>
    </DigitalClock>

    <!-- La mascotte, en plein écran : masquée en mode veille (écran toujours allumé) pour économiser la batterie. -->
    <ComplicationSlot slotId="0" displayName="Mascotte" x="101" y="118" width="248" height="248"
        supportedTypes="PHOTO_IMAGE SMALL_IMAGE" isCustomizable="TRUE">
      <!-- Le type de secours doit faire partie de supportedTypes, même sans source système (EMPTY) :
           sinon Wear OS refuse d'ajouter le cadran. -->
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE"
          primaryProvider="fr.codingpacer.agentchi/fr.codingpacer.agentchi.widget.PetComplicationService"
          primaryProviderType="PHOTO_IMAGE" />
      <BoundingBox x="0" y="0" width="248" height="248" />
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Complication type="PHOTO_IMAGE">
        <PartImage x="0" y="0" width="248" height="248">
          <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
        </PartImage>
      </Complication>
      <Complication type="SMALL_IMAGE">
        <PartImage x="0" y="0" width="248" height="248">
          <Image resource="[COMPLICATION.SMALL_IMAGE]" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- Forme de la mascotte (🔔 quand un agent attend), ou la date si on choisit une autre source. -->
    <ComplicationSlot slotId="1" displayName="Bas" x="125" y="364" width="200" height="56"
        supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
      <DefaultProviderPolicy defaultSystemProvider="DAY_AND_DATE" defaultSystemProviderType="SHORT_TEXT"
          primaryProvider="fr.codingpacer.agentchi/fr.codingpacer.agentchi.widget.PetComplicationService"
          primaryProviderType="SHORT_TEXT" />
      <BoundingRoundBox x="0" y="0" width="200" height="56" cornerRadius="28" />
      <Complication type="SHORT_TEXT">
        <PartText x="0" y="0" width="200" height="56">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="30" color="#FFD97757">
              <Template>%s %s<Parameter expression="[COMPLICATION.TITLE]" /><Parameter expression="[COMPLICATION.TEXT]" /></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
    </ComplicationSlot>
  </Scene>
</WatchFace>
