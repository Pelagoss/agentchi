{
  "name": "agentchi",
  "displayName": "Agentchi (watch)",
  "version": "1.1.2",
  "description": "Sends Claude Code events to your Agentchi watch and lets you answer them from it, through your Agentchi server.",
  "author": {
    "name": "Pelagoss"
  },
  "homepage": "https://github.com/Pelagoss/agentchi",
  "repository": "https://github.com/Pelagoss/agentchi",
  "license": "MIT",
  "keywords": [
    "wear-os",
    "notifications",
    "watch",
    "agentchi"
  ],
  "userConfig": {
    "server_url": {
      "type": "string",
      "title": "Server address",
      "description": "Agentchi server, e.g. https://agentchi.dev (shown on the watch)",
      "required": true
    },
    "code": {
      "type": "string",
      "title": "Pairing code",
      "description": "Watch › Settings › Server › New code (XXXX-XXXX-XXXX)",
      "required": true,
      "sensitive": true
    }
  }
}
