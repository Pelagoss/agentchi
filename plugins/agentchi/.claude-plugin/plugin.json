{
  "name": "agentchi",
  "displayName": "Agentchi (montre)",
  "version": "1.1.1",
  "description": "Envoie les événements de Claude Code à ta montre Agentchi et lui permet d'y répondre, via ton serveur Agentchi.",
  "author": {
    "name": "Pelagoss"
  },
  "homepage": "https://github.com/Pelagoss/agentchi",
